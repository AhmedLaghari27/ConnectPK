{
  "expo": {
    "name": "ConnectPK",
    "slug": "connectpk",
    "scheme": "connectpk",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your ConnectPK professional profile.",
          "cameraPermission": "Use your camera to capture a private verification selfie.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#00B7CD",
          "dark": {
            "backgroundColor": "#00B7CD",
            "image": "./assets/logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmed27steam.connectpk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF1D1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2db2e44-c568-4f95-8d5f-f07039c5ae92"
      }
    },
    "owner": "ahmed27s-team",
    "backgroundColor": "#00B7CD"
  }
}
